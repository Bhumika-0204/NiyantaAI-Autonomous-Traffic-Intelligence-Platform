# Niyanta AI AWS Production Environment Variables

# OpenAI API Key for Reasoning/Explainability Agent (Optional but recommended)
OPENAI_API_KEY=sk-proj-your-actual-openai-key-here

# Redis Configuration (Internal Docker service name)
REDIS_HOST=redis
REDIS_PORT=6379

# FastAPI Server Environment
PORT=8000

# Path to ChromaDB for RAG Documents inside backend container
CHROMA_DB_PATH=/app/data/vector_store
